@startuml
title Pengelolaan Booking Vendor - Swimlane Visual (Jejak Rimba)
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam swimlaneBackgroundColor #F8F9FA
skinparam swimlaneBorderColor #4A5568
skinparam activityBackgroundColor #E8F0FE
skinparam activityBorderColor #4A5568
skinparam activityFontColor #1A1A2E
skinparam activityFontSize 10
skinparam diamondBackgroundColor #FFE0B2
skinparam diamondBorderColor #4A5568
skinparam diamondFontColor #1A1A2E

|Vendor|
start
:Memilih Booking yang Masuk;
:Menampilkan Detail Booking;

|Sistem|
:Memverifikasi Kepemilikan Booking;
if (Booking Milik Vendor?) then ([Ya])
  :Menampilkan Status Saat Ini;
  if (Status Booking?) then ([Menunggu Konfirmasi])
    |Vendor|
    :Mengonfirmasi Booking;
    |Sistem|
    :Memperbarui Status jadi Dikonfirmasi;
    :Menandai Booking jadi Sedang Berjalan;
    :Menandai Booking jadi Selesai;
  elseif ([Sedang Berjalan])
    |Vendor|
    :Menandai Alat Dikembalikan;
    |Sistem|
    :Memperbarui Status jadi Selesai;
  elseif ([Dibatalkan])
    :Menampilkan Pesan Dibatalkan;
    stop
  else ([Sudah Selesai])
    :Menampilkan Pesan Selesai;
    stop
  endif
else ([Tidak])
  :Menampilkan Error Akses Ditolak;
  stop
endif

fork
  :Memperbarui Database Booking;
fork again
  :Memvalidasi Ulang Cache Halaman;
end fork

stop
@enduml