@startuml
title Autentikasi User - Swimlane Visual (Jejak Rimba)
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam swimlaneBackgroundColor #F8F9FA
skinparam swimlaneBorderColor #4A5568
skinparam activityBackgroundColor #E8F0FE
skinparam activityBorderColor #4A5568
skinparam activityFontColor #1A1A2E
skinparam activityFontSize 10
skinparam diamondBackgroundColor #FFE0B2
skinparam diamondBorderColor #4A5568
skinparam diamondFontColor #1A1A2E

|Pengguna|
start
if (Memiliki Akun?) then ([Tidak])
  :Memilih Menu Daftar;
  :Mengisi Data Registrasi;
  :Memilih Role (Penyewa/Vendor);
  |Sistem|
  :Memvalidasi Data Registrasi;
  if (Data Valid?) then ([Ya])
    :Membuat Akun di Auth;
    :Menyimpan Profil Pengguna;
    if (Role Vendor?) then ([Ya])
      :Menyimpan Data Usaha Vendor;
    else ([Penyewa])
    endif
    :Mengarahkan ke Beranda;
  else ([Tidak])
    :Menampilkan Error Registrasi;
    stop
  endif
else ([Ya])
  :Memilih Menu Masuk;
  :Memasukkan Email & Password;
  |Sistem|
  :Memverifikasi Kredensial;
  if (Kredensial Benar?) then ([Ya])
    if (Login via Google?) then ([Ya])
      :Mengarahkan ke OAuth Google;
      :Menerima Callback & Buat Sesi;
    else ([Email/Password])
    endif
    :Membuat Sesi Login;
    :Mengarahkan ke Halaman Akun;
  else ([Tidak])
    :Menampilkan Error Login;
    stop
  endif
endif

|Pengguna|
:Menggunakan Aplikasi;

if (Ingin Keluar?) then ([Ya])
  |Sistem|
  :Menghapus Sesi;
  :Mengarahkan ke Beranda;
  stop
else ([Tidak])
  :Melanjutkan Aktivitas;
endif

stop
@enduml